  "scripts": {
    "start": "expo start",
    "test": "node --test home-monitor/*.test.mjs tests/*.test.mjs",
    "test:training": "python -m unittest discover -s home-monitor/training -p test_*.py -v",
    "monitor:home": "node --env-file=home-monitor/.env home-monitor/worker.mjs",
    "monitor:pose": "node --env-file=home-monitor/.env home-monitor/pose-service-launcher.mjs",
    "monitor:start": "node --env-file=home-monitor/.env home-monitor/start-monitoring.mjs",
    "monitor:hub": "node --env-file=home-monitor/.env home-monitor/hub.mjs",
    "monitor:doctor": "node --env-file=home-monitor/.env home-monitor/doctor.mjs",
    "monitor:pair": "node --env-file=home-monitor/.env home-monitor/pair-device.mjs",
    "monitor:credentials": "powershell -NoProfile -ExecutionPolicy Bypass -File home-monitor/set-credentials.ps1",
    "monitor:families": "node --env-file=home-monitor/.env home-monitor/list-families.mjs",
    "monitor:model-check": "node --env-file=home-monitor/.env home-monitor/check-model.mjs",
    "monitor:dataset-prepare": "node home-monitor/evaluation/prepare-urfall.mjs",
    "monitor:dataset-evaluate": "node --env-file=home-monitor/.env home-monitor/evaluation/evaluate-dataset.mjs",
    "monitor:camera-check": "node --env-file=home-monitor/.env home-monitor/check-camera.mjs",
    "db:check": "node --env-file=.env check-db.mjs",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
