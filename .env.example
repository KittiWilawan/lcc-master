# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_AI_FUNCTION_NAME=analyze-fall
# app_background = แอป Android ตรวจภาพต่อเมื่อปิดหน้าจอ
# home_worker = ใช้คอมบ้านตรวจภาพ (โหมดเดิม)
EXPO_PUBLIC_AI_MODE=app_background
EXPO_PUBLIC_AI_INTERVAL_MS=3000
EXPO_PUBLIC_AI_CAPTURE_QUALITY=0.45
EXPO_PUBLIC_AI_FALL_CONFIDENCE=0.9
EXPO_PUBLIC_AI_CONFIRMATIONS=2
EXPO_PUBLIC_BACKGROUND_CONFIG_REFRESH_MS=30000
EXPO_PUBLIC_EVIDENCE_URL_TTL_SECONDS=900
EXPO_PUBLIC_MONITOR_STATUS_POLL_MS=15000
EXPO_PUBLIC_MONITOR_STATUS_STALE_MS=180000
EXPO_PUBLIC_MONITOR_DEVICE_FUNCTION_NAME=monitor-device
EXPO_PUBLIC_AI_IDENTITY_CONFIDENCE=0.8

EXPO_PUBLIC_CAMERA_TEST_TIMEOUT_MS=10000
EXPO_PUBLIC_AUTH_SESSION_TIMEOUT_MS=5000
EXPO_PUBLIC_EMERGENCY_PHONE_NUMBER=1669
